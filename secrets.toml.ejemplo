# Copia este contenido en Streamlit Cloud: Settings → Secrets
# (o en .streamlit/secrets.toml si la corres en tu computadora; ese archivo nunca se sube a GitHub).

ADMIN_PASSWORD = "cambia-esta-clave"
SHEET_URL = "https://docs.google.com/spreadsheets/d/PEGA_AQUI_EL_ID/edit"

# Pega aquí los datos del archivo .json de la cuenta de servicio de Google Cloud.
[gcp_service_account]
type = "service_account"
project_id = ""
private_key_id = ""
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "app-reservas@tu-proyecto.iam.gserviceaccount.com"
client_id = ""
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = ""
